# ============================================================================
# DTales Tech — Backend Environment Variables (PRODUCTION)
# ============================================================================
# This file is a TEMPLATE.
# Copy values into Render → Service → Environment
# DO NOT commit real secrets.
# DO NOT use this file directly on Render.
# ============================================================================

# ============================================================================
# FRONTEND CORS (REQUIRED IN PRODUCTION)
# ============================================================================
# Public frontend domain (NO trailing slash)
# Example: https://dtales.tech
FRONTEND_URL=

# ============================================================================
# NODE ENVIRONMENT (REQUIRED)
# ============================================================================
# Must be "production" on Render
NODE_ENV=production

# ============================================================================
# SUPABASE STORAGE (REQUIRED)
# ============================================================================
# Get values from Supabase project settings
SUPABASE_URL=https://tbuthdxhaalibmsv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=dtales-media

# ============================================================================
# SERVER
# ============================================================================
# Render automatically exposes PORT, but backend defaults to 10000
PORT=10000

# ============================================================================
# ADMIN AUTH (REQUIRED)
# ============================================================================
# Used by POST /api/auth/login and by requireAuth to verify tokens on
# protected blogs/case-studies/portfolio/uploads routes.
# JWT_SECRET: long random string, e.g. `openssl rand -hex 32`
# ADMIN_PASSWORD_HASH: bcrypt hash of the admin password, e.g.
#   node -e "require('bcrypt').hash('yourpassword', 10).then(console.log)"
# Never commit the plaintext password or a weak JWT_SECRET.
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# ============================================================================
# RATE LIMITING (OPTIONAL — sane production defaults apply if unset)
# ============================================================================
# Each bucket is isolated: public reads, uploads, admin CRUD writes, and
# login never share a counter. See middleware/security.js (apiRateLimiter).
# PUBLIC_RATE_LIMIT_MAX=1000        # GET /api/blogs|case-studies|portfolio
# UPLOAD_RATE_LIMIT_MAX=1500        # /api/uploads/*
# ADMIN_RATE_LIMIT_MAX=2000         # POST/PUT/PATCH/DELETE on blogs|case-studies|portfolio
# AUTH_RATE_LIMIT_MAX=20            # POST /api/auth/login
# RATE_LIMIT_MAX=100                # fallback bucket, e.g. /api/docs
# *_RATE_LIMIT_WINDOW_MS default to 900000 (15 min) for all buckets above

# ============================================================================
# REQUIRED VARIABLES CHECKLIST
# ============================================================================
# Backend WILL FAIL TO START if any of these are missing:
# - SUPABASE_URL
# - SUPABASE_SERVICE_ROLE_KEY
# - SUPABASE_BUCKET
# - JWT_SECRET
# - ADMIN_USERNAME
# - ADMIN_PASSWORD_HASH
#
# Expected startup logs:
# ✔ Environment variables validated
# ✔ Backend running on port 10000

